    - target: {fileID: 7336317802679948930, guid: 134a244b3e93b4ff4b405ce8d4a4ab5c, type: 3}
      propertyPath: m_Text
      value: "(\uAC8C\uC784 \uC774\uB984)\uC740 \uB098\uC624\uB294 \uBAAC\uC2A4\uD130\uB97C
        \uCCAD\uC18C\uD574\uAC00\uBA70 \uC790\uC2E0\uC758 \uBB34\uAE30 \uB610\uB294
        \uC2A4\uD0EF\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD574\uB098\uAC00\uB294
        \uAC8C\uC784\uC785\uB2C8\uB2E4.\nwasd \uB85C \uC790\uC2E0\uC744 \uC6C0\uC9C1\uC774\uACE0
        \uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uACFC \uC6B0\uD074\uB9AD\uC73C\uB85C
        \uC801\uC744 \uACF5\uACA9\uD558\uC5EC\n\uBAAC\uC2A4\uD130\uB4E4\uC774 \uC6B0\uAE00\uAC70\uB9AC\uB294
        \uC138\uC0C1\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC73C\uC138\uC694!"
      objectReference: {fileID: 0}
